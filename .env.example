# ==========================================
# CFBD Quantitative Pricing Terminal & Calibration Gate
# ==========================================

# Required Server-Side Secret: Google Gemini API Key (Qualitative Commentary Only)
# DO NOT prefix with VITE_ to prevent client bundle leakage. Set in private environment or host secrets.
GEMINI_API_KEY=

# Optional Server-Side Secret: The Odds API Key (NCAAF Real-Time Odds Feed)
ODDS_API_KEY=
THE_ODDS_API_KEY=

# Optional: CollegeFootballData.com (CFBD) API Key for real-time SP+/SRS/Elo ratings
CFBD_API_KEY=

# Optional: External Validated Pricing Engine Base URL (e.g., http://localhost:8000 or https://pricing-engine.internal)
# If left unset, the backend runs the internal validated pricing client and walk-forward calibration gate.
PRICING_ENGINE_API_URL=

# Allowed CORS Origins (comma-separated list) - Default safe local / container origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,*

# Rate Limiter Window & Max Requests per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=45

# Optional Redis Connection (for distributed rate limiting & cluster caching)
REDIS_URL=redis://127.0.0.1:6379

# GenAI Resilience & Exponential Backoff Controls
AI_MAX_RETRIES=4
AI_BASE_DELAY_MS=600
AI_MAX_BACKOFF_MS=60000

# GenAI LRU Cache Parameters
AI_CACHE_TTL_SEC=600
AI_CACHE_MAX_ITEMS=250

# Prompt Compaction & Context Token Limits
AI_MAX_TOKENS_PER_REQUEST=3000
MODEL_MAX_CONTEXT_TOKENS=32768
